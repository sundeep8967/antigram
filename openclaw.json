{
  "$schema": "https://openclaw.ai/config.schema.json",
  "name": "openclaw-antigravity-environment",
  "version": "1.0.0",
  "channels": {
    "telegram": {
      "enabled": true,
      "bot_token": "${TELEGRAM_BOT_TOKEN}",
      "allowed_users": [],
      "polling": true,
      "system_prompt": "You are OpenClaw on Telegram powered by Google Antigravity Gemini 3.7. You can execute autonomous web scraping, code review, and developer tasks."
    }
  },
  "models": {
    "default": "gemini-3.7-flash",
    "providers": {
      "antigravity": {
        "type": "openai-compatible",
        "api_base": "http://127.0.0.1:9099/v1",
        "api_key": "sk-antigravity-local-quota",
        "models": [
          "gemini-3.7-flash",
          "gemini-3.7-pro",
          "gemini-2.0-flash",
          "gemini-2.0-flash-thinking-exp-01-21"
        ]
      }
    }
  },
  "agent": {
    "model": "gemini-3.7-flash",
    "temperature": 0.3,
    "max_tokens": 8192,
    "thinking_budget": 4096,
    "system_prompt": "You are OpenClaw running on Google Antigravity quotas. You have full access to high-reasoning Gemini 3.7 / 2.0 capabilities, browser automation, and MCP tools."
  },
  "mcp_servers": {
    "supabase": {
      "path": "/Users/apple/.gemini/antigravity-ide/mcp/supabase-mcp-server"
    }
  }
}
